{
  "name": "shkoliar/magento-ngrok",
  "description": "Magento 2 module for ngrok.io service support",
  "require": {
    "magento/framework": "*"
  },
  "type": "magento2-module",
  "license": [
    "MIT"
  ],
  "authors": [
    {
      "name": "Dmytro Shkoliar",
      "email": "dmytro@shkoliar.com",
      "homepage": "https://shkoliar.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Shkoliar\\Ngrok\\": ""
    }
  },
  "version": "1.1.0",
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
